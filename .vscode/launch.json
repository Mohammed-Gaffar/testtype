{
  "version": "0.2.0",
  "configurations": [
    {
        "name": "Attach to Chrome",
        "port": 3000,
        "request": "attach",
        "type": "chrome",
      "webRoot": "${workspaceFolder}/src",
    },
    {
      "name": "Debug React App",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/src",
      "runtimeExecutable": "C:/Program Files/Google/Chrome/Application/chrome.exe"
    }
  ]
}